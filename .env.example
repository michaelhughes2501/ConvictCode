# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it with real secrets.

SECRET_KEY=dev-secret-key-change-in-production
# Local dev default: sqlite:///felon_dating.db
# Production (Neon Postgres): postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=sqlite:///felon_dating.db
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1
ANTHROPIC_API_KEY=your-anthropic-api-key-here
